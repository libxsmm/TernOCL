// Whole-kernel vISA variant of bitcos_fp16_upcvt_gemv (vISA generated by the modular kernel generator, run 50 "v50_seq",
// NSG=16 LS=1 SW=2; inlined here as two __asm__ blocks).
//
// Same kernel name / arguments / launch as bitcos_fp16_upcvt.cl (run with --nsg 16 --ls 1, M = 1, SGM = 1, no epilogue),
// so the driver A/Bs the two with --cl. The kernel is the NSG=16 LS=1 design (SW=2: one d32x3 sign load per two 32-row blocks; v45 had three 4-byte loads), baked for
// sign words consecutive per column (paper layout, one d32x3 sign load per two 32-row blocks), K = 16384, N = 32768 (other shapes write nothing and fail validation): the LUT holds four fp8-high-byte codes per entry,
// B is widened to fp16 by byte moves, the scale is applied once per 128-row group on the fp32 dpas partial sum.
// The gemm_mt prefill kernel and everything else is the baseline file's (its gemv is built as _ref and unused).
#define bitcos_fp16_upcvt_gemv bitcos_fp16_upcvt_gemv_ref
#include "bitcos_fp16_upcvt.cl"
#undef bitcos_fp16_upcvt_gemv

#define VISA_K 16384
#define VISA_N 32768

__attribute__((intel_reqd_sub_group_size(16)))
__attribute__((reqd_work_group_size(256, 1, 1)))
__kernel void bitcos_fp16_upcvt_gemv(const __global dt *A, const __global uint *B, const __global dt *S,
        const __global uint *SR, __global ct *C, EPI_ARGS, int M, int N, int K) {
